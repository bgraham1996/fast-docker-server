# Copy to .env and adjust. .env is gitignored and dockerignored — never commit
# real secrets. These map 1:1 onto the fields in app/config.py.

APP_NAME="FastAPI Docker Server"
ENVIRONMENT=development        # development | staging | production
DEBUG=false

HOST=0.0.0.0
PORT=8000

# Comma-separated. Use specific origins in production, e.g.:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# Storage backend. Leave unset/empty for the in-memory store (no database needed).
# Set a SQLAlchemy async URL to persist to a real database instead (needs the `db`
# extra: uv sync --extra db). Examples:
#   DATABASE_URL=sqlite+aiosqlite:///./app.db
#   DATABASE_URL=postgresql+asyncpg://app:change-me@db:5432/app
# DATABASE_URL=
